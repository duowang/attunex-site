{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "attunex-site",
  "compatibility_date": "2026-08-03",
  "routes": [
    {
      "pattern": "attunex.app",
      "custom_domain": true
    },
    {
      "pattern": "www.attunex.app",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "."
  }
}
